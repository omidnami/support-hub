# Copy this file to .env and fill in real values.
HUB_DB_HOST=127.0.0.1
HUB_DB_PORT=3306
HUB_DB_NAME=support_hub
HUB_DB_USER=hub_user
HUB_DB_PASSWORD=change-me
HUB_HOST=127.0.0.1
HUB_PORT=8765

# Set to 1 only when the service is behind a trusted reverse proxy.
HUB_TRUST_PROXY=0
# Origin policy for Socket.IO and the /api/files CORS preflight: "*" accepts
# widgets on any store domain, empty keeps the same-origin default, or list
# exact origins separated by commas.
HUB_ALLOWED_ORIGINS=*
HUB_LOG_LEVEL=INFO

# Shared server-to-server token used by the Bale bridge Socket.IO connection.
# Generate a long random value and use the same value in both services.
HUB_BALE_SERVICE_TOKEN=change-me-with-a-long-random-secret
# Internal URL of the Bale service for on-demand file downloads (never public).
BALE_SERVICE_URL=http://127.0.0.1:8766
# Per-read timeout for proxying a file from the adapter (seconds).
HUB_FILE_TIMEOUT=30

# Offline store webhook (Planet ingest). Keep these safe in production:
# - HTTPS is required unless HUB_WEBHOOK_ALLOW_HTTP=1
# - private/loopback/link-local targets are rejected unless the allow flag is 1
# - the per-project secret is generated by Hub and returned only once
HUB_WEBHOOK_ALLOW_HTTP=0
HUB_WEBHOOK_ALLOW_PRIVATE=0
HUB_WEBHOOK_TIMEOUT=5

# Optional Redis metadata cache. MySQL stays the source of truth.
# Leave HUB_REDIS_URL empty to disable caching entirely.
# The Bale service also uses it for the temporary failed-update window.
HUB_REDIS_URL=
# Fail closed on token/webhook/source mutations when Redis is configured but down.
HUB_CACHE_STRICT=0
# TTLs are seconds: 3h webhook/source, 15m token, 60s negative.
HUB_CACHE_TTL_WEBHOOK=10800
HUB_CACHE_TTL_SOURCE=10800
HUB_CACHE_TTL_TOKEN=900
HUB_CACHE_TTL_NEGATIVE=60

# Bale bridge (run with: python -m bale_service)
HUB_URL=http://127.0.0.1:8765
BALE_API_BASE=https://tapi.bale.ai
# Public HTTPS origin that Bale can call; port must be 443 or 88.
BALE_PUBLIC_BASE_URL=https://support.example.com
BALE_SERVICE_HOST=127.0.0.1
BALE_SERVICE_PORT=8766
BALE_SYNC_INTERVAL=30
BALE_REQUEST_TIMEOUT=15
BALE_HUB_ACK_TIMEOUT=10
BALE_MAX_UPDATE_BYTES=1048576
BALE_WEBHOOK_REQUIRE_HTTPS=1
# Set to 1 only for local development without a public HTTPS URL.
BALE_DISABLE_WEBHOOK_REGISTRATION=0
BALE_LOG_LEVEL=INFO

# Temporary file cache (files are never stored permanently in Hub).
BALE_FILE_CACHE_DIR=
# Keep at or below the 1-hour Bale getFile link validity.
BALE_FILE_CACHE_TTL=3600
BALE_FILE_CACHE_MAX_BYTES=536870912
# Bale bots can download at most 20MB per file.
BALE_FILE_MAX_BYTES=20971520
BALE_FILE_DOWNLOAD_TIMEOUT=30
