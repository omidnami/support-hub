[Unit]
Description=Support Hub communication gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=planet
Group=planet
WorkingDirectory=/home/planet/support-hub
ExecStart=/bin/bash -c 'source /home/planet/support-hub/.env && exec /home/planet/support-hub/.venv/bin/python -m support_hub'
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
