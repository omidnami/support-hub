# Copy to /home/planet/support-hub/.env, owner planet, chmod 600.
# Shell syntax: quote passwords safely; never commit the resulting .env.
export HUB_HOST=127.0.0.1
export HUB_PORT=8765
export HUB_HTTP_PORT=8766
export HUB_REDIS_PREFIX='support-hub:'
# DB 1 is a proposal: check it is not allocated to another application first.
# Use a randomly generated hex password so no URL escaping is needed.
export HUB_REDIS_URL='redis://supporthub:REPLACE_REDIS_PASSWORD@127.0.0.1:6379/1'
export HUB_TTL_SECONDS=18000
export HUB_RETRY_SECONDS=10
# Create database and user in cPanel. Import schema.sql into that database via phpMyAdmin.
export HUB_DB_HOST=127.0.0.1
export HUB_DB_PORT=3306
export HUB_DB_NAME=planet_supporthub
export HUB_DB_USER=planet_supporthub
export HUB_DB_PASSWORD='REPLACE_DB_PASSWORD'
export HUB_ENCRYPTION_KEY='REPLACE_FERNET_KEY'
export HUB_MANAGEMENT_KEY='REPLACE_MANAGEMENT_KEY'
export HUB_PUBLIC_BASE_URL='https://hub.planetscripts.ir'
