# Include inside the SSL virtual host for the chosen Hub subdomain, NOT in
# the existing PlanetScripts site's vhost. Verify enabled proxy modules first.
ProxyRequests Off
ProxyPass "/ws" "ws://127.0.0.1:8765/ws"
ProxyPassReverse "/ws" "ws://127.0.0.1:8765/ws"
ProxyPass "/webhook/" "http://127.0.0.1:8766/webhook/"
ProxyPassReverse "/webhook/" "http://127.0.0.1:8766/webhook/"
# Management stays loopback-only by default. Never log webhook callback
# secrets in URLs or query strings. Configure vhost access logs accordingly
# before enabling actual provider callbacks.
