# Source this file in a shell after replacing both tokens with random secrets.
export HUB_HOST=127.0.0.1
export HUB_PORT=8765
export HUB_REDIS_URL=redis://127.0.0.1:6379/0
export HUB_TTL_SECONDS=18000
export HUB_RETRY_SECONDS=10
export HUB_ENDPOINTS='{"demo":{"admin":{"token":"REPLACE_WITH_RANDOM_ADMIN_SECRET","peers":["public"]},"public":{"token":"REPLACE_WITH_RANDOM_PUBLIC_SECRET","peers":["admin"]}}}'

